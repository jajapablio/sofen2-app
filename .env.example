NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
STRIPE_SECRET_KEY=YOUR_SERVER_ONLY_STRIPE_SECRET_KEY
BREVO_API_KEY=YOUR_SERVER_ONLY_BREVO_API_KEY
TWILIO_AUTH_TOKEN=YOUR_SERVER_ONLY_TWILIO_AUTH_TOKEN
QUICKBOOKS_CLIENT_SECRET=YOUR_SERVER_ONLY_QUICKBOOKS_CLIENT_SECRET
# Server-only EmailJS password reset configuration. Do not use NEXT_PUBLIC_ prefixes.
EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_PASSWORD_RESET_TEMPLATE_ID
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
EMAILJS_PRIVATE_KEY=YOUR_EMAILJS_PRIVATE_KEY
# Generate at least 32 random bytes (for example: openssl rand -hex 32).
PASSWORD_RESET_SECRET=YOUR_RANDOM_SERVER_ONLY_SECRET_AT_LEAST_32_CHARACTERS
